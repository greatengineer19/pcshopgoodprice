# Dockerfile.dev - Minimal
FROM ruby:3.4.7

WORKDIR /app

# Only install PostgreSQL dev library
RUN apt-get update -qq && \
    apt-get install --no-install-recommends -y \
    libpq-dev && \
    rm -rf /var/lib/apt/lists/*

COPY Gemfile Gemfile.lock ./
RUN bundle install

EXPOSE 3000
CMD ["./bin/rails", "server", "-b", "0.0.0.0"]