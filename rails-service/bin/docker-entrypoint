#!/bin/bash
set -e

echo "Current RAILS_ENV: ${RAILS_ENV:-development}"

# Remove a potentially pre-existing server.pid for Rails.
rm -f /app/tmp/pids/server.pid

# If running the rails server then create or migrate existing database
if [ "${1}" = "./bin/rails" ] && [ "${2}" = "server" ] && [ "${RAILS_ENV}" != "test" ]; then
  echo "Running database migrations..."
  ./bin/rails db:migrate
  echo "All databases ready!"
  
  # Start SolidQueue worker in background
  echo "Starting SolidQueue worker..."
  bundle exec rake solid_queue:start &
  WORKER_PID=$!
  
  # Trap signals to gracefully shutdown both server and worker
  trap "echo 'Shutting down...'; kill -TERM $WORKER_PID 2>/dev/null || true; wait $WORKER_PID 2>/dev/null || true" SIGTERM SIGINT EXIT
  
  echo "SolidQueue worker started (PID: $WORKER_PID)"
fi

exec "${@}"